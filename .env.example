# ==========================================
# CONFIGURATION PROTOTYPE COD MAROC
# ==========================================

# 1. URL Webhook pour la réception automatique des commandes (Optionnel)
# Exemple : Webhook Google Apps Script pour insérer chaque commande dans Google Sheets,
# ou webhook Make / Zapier.
ORDERS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# 2. Pixel Facebook global par défaut (Optionnel si défini dans le JSON du produit)
NEXT_PUBLIC_DEFAULT_PIXEL_ID=123456789012345

# 3. Port d'exécution (défaut: 3000)
PORT=3000
