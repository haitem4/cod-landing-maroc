# ==============================================================
# CONFIGURATION E-COMMERCE INTERNATIONAL & PAIEMENTS SECURISES
# ==============================================================

# Meta Pixel (Facebook Ads)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=796261734474935

# Google Sheets Web App URL (pour synchronisation des commandes)
# Obtenue via Extension > Apps Script > Déployer en tant qu'application Web
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbx.../exec

# Stripe (Paiement par Carte Bancaire Visa, Mastercard, Amex, Apple Pay)
# Clé publique disponible sur dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Liens de paiement directs Stripe Checkout (optionnel)
NEXT_PUBLIC_STRIPE_LINK_1_PAIR=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_2_PAIRS=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_3_PAIRS=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_5_PAIRS=https://buy.stripe.com/...

# PayPal (Boutons Smart PayPal, Pay Later, Carte Débit/Crédit)
# Client ID disponible sur developer.paypal.com/dashboard/applications
# Utilisez 'sb' pour le mode Sandbox/Test
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb
